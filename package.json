{
  "name": "template-engine",
  "version": "0.1.0",
  "description": "Libreria UI5 per template HTML con segnaposto, elenchi ripetibili ed export PDF/Word.",
  "private": true,
  "files": [
    "dist",
    "src",
    "ui5.yaml"
  ],
  "devDependencies": {
    "@sapui5/types": "~1.148.0",
    "@ui5/cli": "^4.0.33",
    "typescript": "^5.9.3",
    "ui5-tooling-transpile": "3.11.1"
  },
  "scripts": {
    "build": "ui5 build --clean-dest --dest dist",
    "ts-typecheck": "tsc --noEmit",
    "prebuild": "npm run ts-typecheck",
    "start": "ui5 serve",
    "prepare": "npm run build"
  }
}
